{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SS TARIFF",
  "version": "0.1.0",
  "identifier": "com.sstariff.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SS TARIFF",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**", "$PICTURE/**", "$HOME/OneDrive/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCRUQ1NUY5Q0IyRDdDQQpSV1RLMTdLY1g5VytCQU84UW9leUxhc1JlRTJRVE5mZVpGcFRGL2FMODdpTFdQRUU3SjhVbDVhego=",
      "endpoints": [
        "https://github.com/avenkoze/ss-tariff/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
